#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  face             Pick an emoji interactively (uses fzf if installed)
  face <name>      Copy an emoji to clipboard
  face -l          List emojis
  face -s <query>  Searches by name (substring)

Examples:
  face
  face lenny
  face shrug
  face tableflip
  face -l
  face -s flip
USAGE
}

declare -A FACES=(
  [lenny]='( ͡° ͜ʖ ͡°)'
  [shrug]='¯\_(ツ)_/¯'
  [tableflip]='(╯°□°）╯︵ ┻━┻'
  [unflip]='┬─┬ ノ( ゜-゜ノ)'
  [disapprove]='ಠ_ಠ'
  [happy]='(ﾉ◕ヮ◕)ﾉ*:･ﾟ✧'
  [cry]='(ಥ﹏ಥ)'
  [angry]='(ง’̀-’́)ง'
  [sad]='(ㅠ﹏ㅠ)'
)

list_faces() {
  for k in "${!FACES[@]}"; do
    printf "%-12s %s\n" "$k" "${FACES[$k]}"
  done | sort
}

search_faces() {
  local q="$1"
  for k in "${!FACES[@]}"; do
    if [[ "$k" == *"$q"* ]]; then
      printf "%-12s %s\n" "$k" "${FACES[$k]}"
    fi
  done | sort
}

copy_face() {
  local name="$1"
  if [[ -z "${FACES[$name]+x}" ]]; then
    echo "face: I don't know '$name'." >&2
    echo "Try: face -l" >&2
    return 1
  fi
  cb "${FACES[$name]}"
  echo "Copied: $name to clipboard"
}

# Fallback picker without fzf: numbered menu. The UI goes to stderr so that
# stdout carries only the chosen name. Returns 1 if the user quits.
menu_pick() {
  local -a names
  local i reply
  mapfile -t names < <(printf '%s\n' "${!FACES[@]}" | sort)

  for i in "${!names[@]}"; do
    printf '%2d) %-12s %s\n' "$((i + 1))" "${names[$i]}" "${FACES[${names[$i]}]}" >&2
  done

  while true; do
    read -r -p "Pick a number or name (q to quit): " reply || { echo >&2; return 1; }
    case "$reply" in
      "") continue ;;
      q|Q) return 1 ;;
    esac
    if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#names[@]} )); then
      printf '%s\n' "${names[$((reply - 1))]}"
      return 0
    fi
    if [[ -n "${FACES[$reply]+x}" ]]; then
      printf '%s\n' "$reply"
      return 0
    fi
    echo "face: invalid choice '$reply'" >&2
  done
}

pick_face() {
  local choice
  if command -v fzf >/dev/null 2>&1; then
    # Esc / Ctrl-C in fzf is a normal cancel, not an error.
    choice="$(list_faces | fzf --prompt='face> ' --height=40% --reverse)" || return 0
    choice="${choice%% *}"
  else
    choice="$(menu_pick)" || return 0
  fi
  [[ -n "$choice" ]] || return 0
  copy_face "$choice"
}

if [[ $# -eq 0 ]]; then
  if [[ -t 0 && -t 1 ]]; then
    pick_face
    exit 0
  fi
  # Not a terminal (pipe, script): there is nobody to pick, so this is misuse.
  usage >&2
  exit 2
fi

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  -l|--list) list_faces; exit 0 ;;
  -s|--search)
    [[ $# -ge 2 ]] || { echo "face: missing query for -s" >&2; exit 2; }
    search_faces "$2"
    exit 0
    ;;
esac

copy_face "$1"
